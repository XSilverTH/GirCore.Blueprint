using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow MainWindow {
  default-width: 800;
  default-height: 600;
  title: "MyApp";

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle {
        title: "MyApp";
        subtitle: "Blueprint shell";
      };
    }

    content: Adw.ViewStack page_stack {
    };
  };
}
